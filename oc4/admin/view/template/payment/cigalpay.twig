{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    {% if currency_warning %}<div class="alert alert-warning"><i class="fa-solid fa-circle-exclamation"></i> {{ currency_warning|e }}</div>{% endif %}
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <p>{{ text_intro }}</p>
        <p>{{ text_notify }} <code>{{ notify_url|e }}</code></p>
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-account-id" class="col-sm-2 col-form-label">{{ entry_account_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_cigalpay_account_id" value="{{ payment_cigalpay_account_id|e }}" id="input-account-id" class="form-control"/>
              <div id="error-account-id" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-ipn-secret" class="col-sm-2 col-form-label">{{ entry_ipn_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_cigalpay_ipn_secret" value="{{ payment_cigalpay_ipn_secret|e }}" id="input-ipn-secret" class="form-control" autocomplete="off"/>
              <div class="form-text">{{ help_ipn_secret }}</div>
              <div id="error-ipn-secret" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_cigalpay_api_key" value="{{ payment_cigalpay_api_key|e }}" id="input-api-key" class="form-control" autocomplete="off"/>
              <div class="form-text">{{ help_api_key }}</div>
            </div>
          </div>
          {% for field in [['pending_status_id', entry_pending_status, ''], ['order_status_id', entry_order_status, ''], ['review_status_id', entry_review_status, help_review_status]] %}
            <div class="row mb-3">
              <label for="input-{{ field[0] }}" class="col-sm-2 col-form-label">{{ field[1] }}</label>
              <div class="col-sm-10">
                <select name="payment_cigalpay_{{ field[0] }}" id="input-{{ field[0] }}" class="form-select">
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == attribute(_context, 'payment_cigalpay_' ~ field[0]) %} selected{% endif %}>{{ order_status.name|e }}</option>
                  {% endfor %}
                </select>
                {% if field[2] %}<div class="form-text">{{ field[2] }}</div>{% endif %}
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_cigalpay_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_cigalpay_geo_zone_id %} selected{% endif %}>{{ geo_zone.name|e }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_debug }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_cigalpay_debug" value="0"/>
                <input type="checkbox" name="payment_cigalpay_debug" value="1" id="input-debug" class="form-check-input"{% if payment_cigalpay_debug %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_debug }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_cigalpay_status" value="0"/>
                <input type="checkbox" name="payment_cigalpay_status" value="1" id="input-status" class="form-check-input"{% if payment_cigalpay_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_cigalpay_sort_order" value="{{ payment_cigalpay_sort_order|e }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
